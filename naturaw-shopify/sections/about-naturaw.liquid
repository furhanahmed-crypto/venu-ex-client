{{ 'NR-about.css' | asset_url | stylesheet_tag }}

<section
  class="nw-about-full nr-about"
  id="about-naturaw-{{ section.id }}"
>
  {% if section.settings.top_left_image %}
    <img
      class="nw-floating nw-top-left"
      src="{{ section.settings.top_left_image | image_url: width: 280 }}"
      alt=""
      loading="lazy"
      width="140"
      height="140"
    >
  {% endif %}

  {% if section.settings.top_right_image %}
    <img
      class="nw-floating nw-top-right"
      src="{{ section.settings.top_right_image | image_url: width: 520 }}"
      alt=""
      loading="lazy"
      width="260"
      height="260"
    >
  {% endif %}

  {% if section.settings.bottom_right_image %}
    <img
      class="nw-floating nw-bottom-right"
      src="{{ section.settings.bottom_right_image | image_url: width: 360 }}"
      alt=""
      loading="lazy"
      width="180"
      height="180"
    >
  {% endif %}

  <div class="nw-safe-wrap">
    <div class="nw-container page-width" data-nr-reveal>
      {% if section.settings.left_main_image %}
        <div class="nw-left">
          <img
            src="{{ section.settings.left_main_image | image_url: width: 800 }}"
            alt=""
            loading="lazy"
            width="420"
            height="420"
          >
        </div>
      {% endif %}

      <div class="nw-content">
        {%- if section.settings.heading != blank -%}
          <h2 class="nw-heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.content != blank -%}
          <div class="nw-text rte">{{ section.settings.content }}</div>
        {%- endif -%}

        {%- if section.settings.button_link != blank -%}
          <a href="{{ section.settings.button_link }}" class="nw-btn">
            {{ section.settings.button_text | escape }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About Naturaw Full",
  "tag": "section",
  "class": "section-nr-about",
  "settings": [
    { "type": "image_picker", "id": "bg_image", "label": "Background Image" },
    { "type": "image_picker", "id": "left_main_image", "label": "Left Main Image" },
    { "type": "image_picker", "id": "top_left_image", "label": "Top Left Floating Image" },
    { "type": "image_picker", "id": "top_right_image", "label": "Top Right Floating Image" },
    { "type": "image_picker", "id": "bottom_right_image", "label": "Bottom Right Floating Image" },
    { "type": "text", "id": "heading", "default": "ABOUT US", "label": "Heading" },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content",
      "default": "<p>At <strong>Naturaw</strong>, we believe good food should come from <strong>good roots</strong>.</p>"
    },
    { "type": "text", "id": "button_text", "default": "VIEW MORE", "label": "Button Text" },
    { "type": "url", "id": "button_link", "label": "Button Link" }
  ],
  "presets": [{ "name": "About Naturaw Full Section" }]
}
{% endschema %}
