{% comment %}
  Hero Banner – Freshness Knocking
{% endcomment %}

<section class="freshness-hero"
  style="
    background-image:url({{ section.settings.bg_image | img_url: '2000x' }});
  ">

  <!-- Floating Images -->
  {% if section.settings.float_top %}
    <img class="float-img top"
         src="{{ section.settings.float_top | img_url: '200x' }}"
         alt="">
  {% endif %}

  {% if section.settings.float_bottom %}
    <img class="float-img bottom"
         src="{{ section.settings.float_bottom | img_url: '200x' }}"
         alt="">
  {% endif %}

  <div class="hero-overlay">
    <div class="hero-content">
      <h1>{{ section.settings.heading }}</h1>

      {% if section.settings.button_text != blank %}
        <a href="{{ section.settings.button_link }}"
           class="hero-btn">
          {{ section.settings.button_text }}
        </a>
      {% endif %}
    </div>
  </div>

</section>

<style>
/* ================= BASE ================= */
.freshness-hero {
  position: relative;
  min-height: 600px;
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  display: flex;
  align-items: center;
  overflow: hidden;
}

/* Rough edges effect */
.freshness-hero::before,
.freshness-hero::after {
  content: "";
  position: absolute;
  left: 0;
  width: 100%;
  height: 50px;
  background: #fff;
  z-index: 3;
}

.freshness-hero::before {
  top: 0;
  clip-path: polygon(0 0, 100% 0, 95% 60%, 5% 100%);
}

.freshness-hero::after {
  bottom: 0;
  clip-path: polygon(5% 0, 95% 40%, 100% 100%, 0 100%);
}

/* ================= OVERLAY ================= */
.hero-overlay {
  background: linear-gradient(
    to right,
    rgba(0,0,0,0.75),
    rgba(0,0,0,0.3)
  );
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
}

/* ================= CONTENT ================= */
.hero-content {
  max-width: 1200px;
  padding: 80px 40px;
  margin: auto;
  text-align: center;
  color: #fff;
  z-index: 5;
}

.hero-content h1 {
  font-size: 58px;
  font-family: 'Georgia', serif;
  font-style: italic;
  font-weight: 600;
  line-height: 1.2;
  margin-bottom: 40px;
}

/* ================= BUTTON ================= */
.hero-btn {
  display: inline-block;
  background: #f7b500;
  color: #fff;
  padding: 14px 36px;
  font-size: 18px;
  font-weight: 700;
  text-transform: uppercase;
  border-radius: 10px;
  text-decoration: none;
  transition: all 0.3s ease;
}

.hero-btn:hover {
  background: #e0a400;
}

/* ================= FLOATING IMAGES ================= */
.float-img {
  position: absolute;
  width: 90px;
  z-index: 6;
}

.float-img.top {
  top: 40px;
  right: 60px;
}

.float-img.bottom {
  bottom: 40px;
  right: 80px;
}

/* ================= TABLET ================= */
@media (max-width: 1024px) {
  .hero-content h1 {
    font-size: 42px;
  }

  .float-img {
    width: 70px;
  }
}

/* ================= MOBILE ================= */
@media (max-width: 768px) {
  .freshness-hero {
    min-height: 480px;
  }

  .hero-content {
    padding: 60px 20px;
  }

  .hero-content h1 {
    font-size: 30px;
  }

  .hero-btn {
    font-size: 16px;
    padding: 12px 28px;
  }

  .float-img {
    display: none;
  }
}
</style>

{% schema %}
{
  "name": "Hero – Freshness Knocking",
  "settings": [
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading Text",
      "default": "“Freshness knocking…\n every single day!”"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "ORDER NOW"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "image_picker",
      "id": "float_top",
      "label": "Floating Image Top Right"
    },
    {
      "type": "image_picker",
      "id": "float_bottom",
      "label": "Floating Image Bottom Right"
    }
  ],
  "presets": [
    {
      "name": "Hero – Freshness Banner"
    }
  ]
}
{% endschema %}
