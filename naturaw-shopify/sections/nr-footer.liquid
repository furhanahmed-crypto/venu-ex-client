{{ 'NR-footer.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign shop_url = section.settings.quick_shop_url
  if shop_url == blank and collections.products != blank
    assign shop_url = collections.products.url
  endif
  if shop_url == blank
    assign shop_url = routes.all_products_collection_url
  endif

  assign products_url = section.settings.products_url
  if products_url == blank and collections.products != blank
    assign products_url = collections.products.url
  endif
  if products_url == blank
    assign products_url = routes.all_products_collection_url
  endif

  assign account_url = routes.account_url
  if customer == null
    assign account_url = routes.account_login_url
  endif

  assign contact_url = section.settings.contact_url
  if contact_url == blank
    assign contact_page = pages.contact
    if contact_page == blank
      assign contact_page = pages['contact-us']
    endif
    if contact_page != blank
      assign contact_url = contact_page.url
    endif
  endif
-%}

<footer class="nr-footer" id="nr-footer-{{ section.id }}">
  <div class="nr-footer__main page-width">
    <div class="nr-footer__grid" data-nr-reveal>
      <div class="nr-footer__col nr-footer__col--brand">
        {% render 'nr-footer-logo', logo_width: 128 %}
        {%- if section.settings.tagline != blank -%}
          <p class="nr-footer__tagline">{{ section.settings.tagline | escape }}</p>
        {%- endif -%}
        {%- if section.settings.show_social -%}
          {% render 'social-icons', class: 'nr-footer__social list-unstyled list-social' %}
        {%- endif -%}
      </div>

      <div class="nr-footer__col">
        <h3 class="nr-footer__heading">{{ section.settings.heading_quick | escape }}</h3>
        <ul class="nr-footer__links">
          <li><a href="{{ routes.root_url }}">{{ section.settings.label_home | escape }}</a></li>
          <li><a href="{{ shop_url }}">{{ section.settings.label_shop | escape }}</a></li>
          <li><a href="{{ account_url }}">{{ section.settings.label_account | escape }}</a></li>
        </ul>
      </div>

      <div class="nr-footer__col">
        <h3 class="nr-footer__heading">{{ section.settings.heading_shop_col | escape }}</h3>
        <ul class="nr-footer__links">
          <li><a href="{{ products_url }}">{{ section.settings.label_products | escape }}</a></li>
          <li><a href="{{ routes.cart_url }}">{{ section.settings.label_cart | escape }}</a></li>
        </ul>
      </div>

      <div class="nr-footer__col">
        <h3 class="nr-footer__heading">{{ section.settings.heading_support | escape }}</h3>
        <ul class="nr-footer__links">
          {%- if shop.policies.privacy_policy -%}
            <li>
              <a href="{{ shop.policies.privacy_policy.url }}">{{ section.settings.label_privacy | escape }}</a>
            </li>
          {%- endif -%}
          {%- if shop.policies.shipping_policy -%}
            <li>
              <a href="{{ shop.policies.shipping_policy.url }}">{{ section.settings.label_shipping | escape }}</a>
            </li>
          {%- endif -%}
          {%- if shop.policies.refund_policy -%}
            <li>
              <a href="{{ shop.policies.refund_policy.url }}">{{ section.settings.label_returns | escape }}</a>
            </li>
          {%- endif -%}
          {%- if shop.policies.terms_of_service -%}
            <li>
              <a href="{{ shop.policies.terms_of_service.url }}">{{ section.settings.label_terms | escape }}</a>
            </li>
          {%- endif -%}
          {%- if contact_url != blank -%}
            <li>
              <a href="{{ contact_url }}">{{ section.settings.label_contact | escape }}</a>
            </li>
          {%- endif -%}
        </ul>
      </div>
    </div>
  </div>

  <div class="nr-footer__bar">
    <div class="nr-footer__bar-inner page-width">
      <div class="nr-footer__bar-start">
        {%- assign nr_footer_year = 'now' | date: '%Y' -%}
        <p class="nr-footer__copyright">
          {{ section.settings.copyright | replace: '[year]', nr_footer_year | escape }}
        </p>
      </div>

      {%- if section.settings.payment_enable -%}
        <div class="nr-footer__payment">
          <span class="visually-hidden">{{ 'sections.footer.payment' | t }}</span>
          {%- if section.settings.payment_image != blank -%}
            {{
              section.settings.payment_image
              | image_url: width: 560
              | image_tag:
                class: 'nr-footer__payment-img',
                widths: '280, 420, 560',
                alt: 'Accepted payment methods',
                loading: 'lazy'
            }}
          {%- elsif section.settings.payment_image_url != blank -%}
            <img
              class="nr-footer__payment-img"
              src="{{ section.settings.payment_image_url | escape }}"
              alt="Accepted payment methods"
              width="320"
              height="36"
              loading="lazy"
            >
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
