      "id": "label_home",
      "label": "Home link label",
      "default": "Home"
    },
    {
      "type": "text",
      "id": "label_shop",
      "label": "Shop link label",
      "default": "Shop"
    },
    {
      "type": "text",
      "id": "label_account",
      "label": "Account link label",
      "default": "Account"
    },
    {
      "type": "url",
      "id": "quick_shop_url",
      "label": "Shop URL override"
    },
    {
      "type": "text",
      "id": "heading_shop_col",
      "label": "Shop column heading",
      "default": "SHOP"
    },
    {
      "type": "text",
      "id": "label_products",
      "label": "Products link label",
      "default": "Products"
    },
    {
      "type": "url",
      "id": "products_url",
      "label": "Products URL override"
    },
    {
      "type": "text",
      "id": "label_cart",
      "label": "Cart link label",
      "default": "Cart"
    },
    {
      "type": "text",
      "id": "heading_support",
      "label": "Support heading",
      "default": "SUPPORT"
    },
    {
      "type": "text",
      "id": "label_privacy",
      "label": "Privacy label",
