    },
    {
      "type": "text",
      "id": "label_shipping",
      "label": "Shipping label",
      "default": "Shipping"
    },
    {
      "type": "text",
      "id": "label_returns",
      "label": "Returns label",
      "default": "Returns"
    },
    {
      "type": "text",
      "id": "label_terms",
      "label": "Terms label",
      "default": "Terms of Service"
    },
    {
      "type": "text",
      "id": "label_contact",
      "label": "Contact label",
      "default": "Contact Us"
