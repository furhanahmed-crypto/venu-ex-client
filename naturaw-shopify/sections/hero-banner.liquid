{{ 'naturaw-revamp-hero.css' | asset_url | stylesheet_tag }}
{{ 'naturaw-revamp-hero-responsive.css' | asset_url | stylesheet_tag }}

<section class="naturaw-hero naturaw-hero--revamp naturaw-hero-final">
  <div class="naturaw-slider">
    {% for block in section.blocks %}
      <div
        class="naturaw-slide{% if forloop.first %} active{% endif %}"
        {{ block.shopify_attributes }}
      >
        {% if block.settings.badge_image != blank %}
          {{
            block.settings.badge_image
            | image_url: width: 300
            | image_tag: class: 'naturaw-badge', loading: 'lazy', widths: '150, 300'
          }}
        {% endif %}

        <div class="naturaw-hero-inner page-width">
          <div class="naturaw-left">
            {% if block.settings.eyebrow_text != blank %}
              <p class="naturaw-hero__eyebrow">{{ block.settings.eyebrow_text | escape }}</p>
            {% endif %}

            {% if block.settings.heading_text != blank %}
              <h1 class="naturaw-heading">
                {% assign heading_lines = block.settings.heading_text | split: '\n' %}
                {% for line in heading_lines %}
                  {% if line contains 'INTO' %}
                    <span class="highlight-word">{{ line | escape }}</span>
                    {% unless forloop.last %}<br>{% endunless %}
                  {% else %}
                    {{ line | escape -}}
                    {%- unless forloop.last %}<br>{% endunless %}
                  {% endif %}
                {% endfor %}
              </h1>
            {% endif %}

            {% if block.settings.subtitle_text != blank %}
              <p class="naturaw-subtitle">{{ block.settings.subtitle_text | escape | newline_to_br }}</p>
            {% endif %}

            {% if block.settings.button_text != blank %}
              <a href="{{ block.settings.button_link }}" class="naturaw-hero__btn naturaw-btn">
                <span>{{ block.settings.button_text | escape }}</span>
                <span class="naturaw-hero__btn-icon">{{ 'icon-arrow.svg' | inline_asset_content }}</span>
              </a>
            {% endif %}
          </div>

          <div class="naturaw-right">
            {% if block.settings.products_image != blank %}
              {{
                block.settings.products_image
                | image_url: width: 1200
                | image_tag: class: 'naturaw-products', loading: 'eager', widths: '600, 900, 1200'
              }}
            {% endif %}

            {% if block.settings.chips_image != blank %}
              <div class="chips-orbit">
                {{
                  block.settings.chips_image
                  | image_url: width: 600
                  | image_tag: class: 'naturaw-chips', loading: 'lazy', widths: '300, 600'
                }}
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const slides = document.querySelectorAll('.naturaw-hero--revamp .naturaw-slide');
    let i = 0;
    if (slides.length > 1) {
      setInterval(() => {
        slides[i].classList.remove('active');
        i = (i + 1) % slides.length;
        slides[i].classList.add('active');
      }, 4000);
    }
  });
</script>

{% schema %}
{
  "name": "Naturaw Hero Slider",
  "settings": [],
  "blocks": [
    {
      "type": "slide",
      "name": "Hero Slide",
      "settings": [
        {
          "type": "text",
          "id": "eyebrow_text",
          "label": "Eyebrow label",
          "default": "Natural & healthy snacking"
        },
        {
          "type": "image_picker",
          "id": "bg_image",
          "label": "Background image (legacy — revamp uses theme background color)"
        },
        {
          "type": "color",
          "id": "bg_color",
          "label": "Fallback color (legacy)",
          "default": "#faf9f6"
        },
        { "type": "image_picker", "id": "badge_image", "label": "Badge image" },
        { "type": "image_picker", "id": "products_image", "label": "Hero product image" },
        { "type": "image_picker", "id": "chips_image", "label": "Secondary product image (optional)" },
        {
          "type": "text",
          "id": "heading_text",
          "label": "Heading",
          "default": "Goodness in Every Bite"
        },
        {
          "type": "textarea",
          "id": "subtitle_text",
          "label": "Subtitle",
          "default": "Wholesome snacks made from real ingredients. No additives. No shortcuts. Just nature’s goodness."
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button text",
          "default": "Shop Healthy Snacks"
        },
        { "type": "url", "id": "button_link", "label": "Button link" }
      ]
    }
  ],
  "presets": [{ "name": "Naturaw Hero Slider" }]
}
{% endschema %}
