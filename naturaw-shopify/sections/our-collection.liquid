<section class="dp-products-section">
  <div class="container">

    {% if section.settings.heading != blank %}
      <div class="dp-heading-wrap-row scroll-top">
        {% if section.settings.decor_left != blank %}
          <img class="dp-decor-left scroll-left" src="{{ section.settings.decor_left | img_url: '100x' }}" alt="decor left">
        {% endif %}

        <h2 class="dp-section-title scroll-top">{{ section.settings.heading }}</h2>

        {% if section.settings.decor_right != blank %}
          <img class="dp-decor-right scroll-right" src="{{ section.settings.decor_right | img_url: '100x' }}" alt="decor right">
        {% endif %}
      </div>
    {% endif %}

    <div class="dp-products-grid dp-columns-3">

      {% for block in section.blocks %}
        {% assign collection = block.settings.collection %}

        {% if block.settings.row_heading != blank %}
          <h2 class="dp-row-heading scroll-top">{{ block.settings.row_heading }}</h2>
        {% endif %}

        {% if collection %}
        <a href="{{ collection.url }}" class="dp-product-card scroll-top">

          {% if block.settings.static_image %}
            <div class="dp-img-wrap">
              <img src="{{ block.settings.static_image | img_url: '600x' }}" alt="">
            </div>
          {% elsif collection.image %}
            <div class="dp-img-wrap">
              <img src="{{ collection.image | img_url: '600x' }}" alt="{{ collection.title }}">
            </div>
          {% endif %}

          <h3 class="dp-title">{{ collection.title }}</h3>

          <p class="dp-text">
            {{ collection.description | strip_html | truncate: 120 }}
          </p>

          {% if section.settings.show_rating %}
          <div class="dp-product-rating">★★★★★</div>
          {% endif %}

        </a>
        {% endif %}
      {% endfor %}

    </div>
  </div>
</section>

<style>
/* ============================
   MOBILE FIRST (base styles)
   Applies to mobile by default
   ============================ */

:root{
  --accent: #faaa22;
  --text-dark: #1a3529;
  --bg-card: #efefef;
  --
}

/* Section + container (mobile defaults) */
.dp-products-section {
  padding: 32px 16px;
  background: #fff;
  text-align: center;
  position: relative;
}
.dp-container {
  max-width: var(--max-width);
  margin: 0 auto;
}

/* Heading row - mobile */
.dp-heading-wrap-row {
  display:flex !important;
  align-items:center;
  justify-content:center;
  gap:12px;
  width:100%;
  margin: 0 auto 28px auto;
  padding: 0 12px;
  flex-wrap:nowrap;
  position: relative;
}

.dp-decor-left,
.dp-decor-right {
  width: 42px;
  height: auto;
  flex: 0 0 42px;
  display: block;
}

.dp-section-title {
  font-family: "Playfair Display", serif;
  color: var(--text-dark);
  font-size: clamp(18px, 6vw, 60px);
  font-weight: 600;
  text-align: center;
  margin: 0;
  flex: 1 1 auto;
  min-width: 0;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* Grid - mobile: single column */
.dp-products-grid.dp-columns-3 {
  display: grid;
  grid-template-columns: 1fr;
  gap: 30px 0;
  align-items: start;
}

/* Product card - mobile */
.dp-product-card {
  background-color: var(--bg-card);
  padding: 12px;
  border-radius: 14px;
  transition: .28s ease;
  display:flex;
  flex-direction: column;
  align-items: stretch;
  text-decoration: none;
  color: inherit;
  overflow: hidden;
}

.dp-product-card:hover {
  background-color: #fff4e6;
  transform: translateY(-6px);
  box-shadow: 0 16px 30px rgba(0,0,0,0.06);
}

/* Image */
.dp-img-wrap {
  height: 300px; /* mobile image height */
  border-radius: 12px;
  overflow: hidden;
  background: #fff;
  display:flex;
  align-items:center;
  justify-content:center;
}

.dp-img-wrap img {
  width:100%;
  height:100%;
  object-fit: cover;
  display:block;
}

/* Titles & text */
.dp-title {
  font-family: "Josefin Sans", sans-serif;
  color: var(--text-dark);
  font-size: 18px;
  font-weight: 600;
  text-transform: uppercase;
  margin: 12px 0 6px;
  line-height: 1.05;
}

.dp-text {
  font-family: "Josefin Sans", sans-serif;
  font-size: 14px;
  color: #000;
  margin: 0 0 10px;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* Rating */
.dp-product-rating {
  font-size: 18px;
  color: var(--accent);
  margin-bottom: 6px;
  line-height: 1;
}

/* Row heading (full width) */
.dp-row-heading {
  grid-column: 1 / -1;
  width: 100%;
  text-align: center;
  font-family: "Playfair Display", serif;
  font-size: 18px;
  font-weight: 500;
  color: var(--text-dark);
  margin: 28px 0 10px;
  opacity: 0.9;
}

/* Scroll animation helpers (base) */
.scroll-left,
.scroll-right,
.scroll-top {
  opacity: 0;
  transform: translateY(18px);
  transition: all 0.9s ease-out;
}

.scroll-left { transform: translateX(-24px); opacity:0; }
.scroll-right { transform: translateX(24px); opacity:0; }
.scroll-top { transform: translateY(24px); opacity:0; }

.reveal {
  opacity: 1 !important;
  transform: translateX(0) translateY(0) !important;
}

/* ============================
   TABLET (min-width: 769px and max-width: 1024px)
   ============================ */
@media (min-width: 769px) and (max-width: 1024px) {

  .dp-heading-wrap-row {
    gap: 18px;
    padding: 0 20px;
    margin-bottom: 40px;
  }

  .dp-decor-left,
  .dp-decor-right {
    width: 110px;
    flex: 0 0 110px;
  }

  .dp-section-title {
    
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* grid -> 2 columns on tablet for better use of space */
  .dp-products-grid.dp-columns-3 {
    grid-template-columns: repeat(3, 1fr);
    gap: 48px 20px !important;
  }

  .dp-img-wrap {
    height: 260px;
    border-radius: 14px;
  }

  .dp-title {
    font-size: 14px;
    margin: 14px 0 8px;
  }

  .dp-text {
    font-size: 14px;
    -webkit-line-clamp: 2;
  }

  

  .dp-product-rating { font-size: 19px; }
}

/* ============================
   DESKTOP (min-width: 1025px)
   ============================ */
@media (min-width: 1025px) {


  .dp-heading-wrap-row {
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 60px;
    padding: 0 12px;
  }

  .dp-decor-left, .dp-decor-right {
    width: 140px;
    flex: 0 0 140px;
  }

  /* Desktop: 3 columns (as you had originally) */
  .dp-products-grid.dp-columns-3 {
    grid-template-columns: repeat(3, 1fr);
    gap: 0px 40px;
  }

  .dp-img-wrap {
    height: 400px;
    border-radius: 20px;
  }

  .dp-title {
    font-size: 20px;
    margin: 24px 0 0px;
  }

  .dp-text {
    font-size: 16px;
    -webkit-line-clamp: 2;
  }


  .dp-product-card { padding: 15px; border-radius: 20px; margin-bottom: 30px;}
}

/* small accessibility tweak: ensure images don't distort */
.dp-img-wrap img { max-width: 100%; height: 100%; object-fit: cover; display:block; }

</style>

<script>
document.addEventListener("DOMContentLoaded", function () {
  // Use IntersectionObserver for performant reveal animations
  const revealElems = document.querySelectorAll(".scroll-left, .scroll-right, .scroll-top");

  if ("IntersectionObserver" in window) {
    const io = new IntersectionObserver((entries, observer) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add("reveal");
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.18 });

    revealElems.forEach(el => io.observe(el));
  } else {
    // Fallback for older browsers
    function fallbackReveal() {
      revealElems.forEach(el => {
        const rect = el.getBoundingClientRect();
        if (rect.top < window.innerHeight - 80) el.classList.add("reveal");
      });
    }
    window.addEventListener("scroll", fallbackReveal);
    fallbackReveal();
  }
});
</script>

{% schema %}
{
  "name": "Categories Section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Categories"
    },
    {
      "type": "image_picker",
      "id": "cow_icon",
      "label": "Cow Icon for Button"
    },
    {
      "type": "image_picker",
      "id": "decor_left",
      "label": "Left Decorative Image"
    },
    {
      "type": "image_picker",
      "id": "decor_right",
      "label": "Right Decorative Image"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show Rating Stars",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Add Category Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Choose Collection"
        },
        {
          "type": "image_picker",
          "id": "static_image",
          "label": "Static Image (Optional)"
        },
        {
          "type": "text",
          "id": "row_heading",
          "label": "Heading Before This Item (Optional)"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Category Collections",
      "category": "Collections"
    }
  ]
}
{% endschema %}
