/* ===== HEADING FIX ===== */
.moringa-heading{
  display:flex;
  flex-direction:column;
  gap:6px; /* 👈 yahin se spacing control */
  margin-bottom:40px;
}

.moringa-heading .sub{
 font-size:30px; Font-weight:bold; color: #2a2a2a;
 font-family:'Carlito', Arial, sans-serif;
 font-weight:normal;
 margin:0 !important;
 line-height:42px;
}

.moringa-heading h2{
    font-family: 'Inter', sans-serif;
  font-weight:900;
Font-size:60px; color:#3f520e; Font-weight:bold; text-transform: uppercase;  text-align:center;
  margin:0 !important;
  line-height:60px;
}

/* Layout */
.moringa-content{
  display:grid;
  grid-template-columns:1fr 60% 1fr;
  align-items:center;
  gap:0px;
  position:relative;
}

/* Center Image */
.moringa-center{
  width:100%;
  margin:auto;
  display:flex;
  align-items:center;
  justify-content:center;
  opacity:0;
  transform: translateY(40px);
  transition: all 0.8s ease;
}

.moringa-center.reveal-active{
  opacity:1;
  transform: translateY(0);
}

.moringa-center img{
  width:100%;
  height:auto;        /* 🔥 important */
  object-fit:unset;
  display:block;
}


/* Benefits */
.benefits{
  display:flex;
  flex-direction:column;
  gap:50px;
  position:relative;
}

.benefit{
  display:flex;
  flex-direction:column;
  align-items:center;
  text-align:center;
  opacity:0;
  transform: translateY(40px);
  transition: all 0.8s ease;
}

.benefit.reveal-active{
  opacity:1;
  transform: translateY(0);
}

.benefit img{
  width:100px;
  margin-bottom:6px;
}

.benefit p{
Font-size:20px;
  color:#2a2a2a;
 font-family:'Carlito', Arial, sans-serif;
  font-weight:400;
  line-height:30px;
  margin:0;
  max-width: 200px;
  text-align: center;
}

/* Floating Images */
.floating-img{
  position:absolute;
  pointer-events:none;
}

.floating-img img{
  width:90px;
  height:90px;
  object-fit:contain;
}
.floating-img.left-bottom.float-left {
 width:90px;
  height:90px;
  object-fit:contain;}

  .floating-img.left-top.float-left {
    width:120px;
  height:120px;
  object-fit:contain;
}
.left-top{ top:-40px; left:0px; }
.left-bottom{ bottom:-150px; left:30px; }
.right-center{ top:50%; right:-8px; transform:translateY(-50%); }

/* Float Animations */
@keyframes floatUpDown {
  0% { transform: translateY(0); }
  50% { transform: translateY(-14px); }
  100% { transform: translateY(0); }
}
@keyframes floatScale {
  0% { transform: translateY(-50%) scale(1); }
  50% { transform: translateY(calc(-50% - 12px)) scale(1.05); }
  100% { transform: translateY(-50%) scale(1); }
}
.float-left{ animation: floatUpDown 6s ease-in-out infinite; }
.float-right{ animation: floatScale 7s ease-in-out infinite; }

/* CTA */
.moringa-cta{
  margin-top:50px;
  opacity:0;
  transform: translateY(40px);
  transition: all 0.8s ease;
}
.moringa-cta.reveal-active{
  opacity:1;
  transform: translateY(0);
}

.btn{
  display: inline-block;
  padding: 12px 40px 9px 40px;
  background-color: #3b5005 !important;
  border-radius: 30px;
  color: #FFF !important;
  font-weight: normal;
  text-decoration: none;
  text-transform: uppercase;
  align-self: flex-start;
  font-size: 16px;
  transition: all 0.5s ease;
  font-family: 'Carlito';
}

.btn:hover{ background-color: #fc2d9a !important;}


