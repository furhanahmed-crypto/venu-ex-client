<section id="moringa-{{ section.id }}" class="moringa-section">
  <div class="moringa-inner">

    <!-- Heading -->
    <div class="moringa-heading">
      <p class="sub">{{ section.settings.subheading }}</p>
      <h2>{{ section.settings.heading }}</h2>
    </div>

    <div class="moringa-content">

      <!-- LEFT COLUMN -->
      <div class="benefits left">

        {% if section.settings.left_top_image %}
          <div class="floating-img left-top float-left">
            <img src="{{ section.settings.left_top_image | image_url }}" alt="">
          </div>
        {% endif %}

        {% for block in section.blocks %}
          {% if block.settings.position == 'left' %}
            <div class="benefit reveal-card"
              style="
                --offset-desktop: {{ block.settings.offset_desktop }}px;
                --offset-tablet: {{ block.settings.offset_tablet }}px;
                --offset-mobile: {{ block.settings.offset_mobile }}px;
                transform: translateX(var(--offset-desktop));
              ">
              {% if block.settings.icon %}
                <img src="{{ block.settings.icon | image_url }}" alt="">
              {% endif %}
              <p>{{ block.settings.text }}</p>
            </div>
          {% endif %}
        {% endfor %}

        {% if section.settings.left_bottom_image %}
          <div class="floating-img left-bottom float-left">
            <img src="{{ section.settings.left_bottom_image | image_url }}" alt="">
          </div>
        {% endif %}

      </div>

      <!-- CENTER IMAGE -->
      <div class="moringa-center reveal-up">
        {% if section.settings.center_image %}
          <img src="{{ section.settings.center_image | image_url: width: 900 }}" alt="">
        {% endif %}
      </div>

      <!-- RIGHT COLUMN -->
      <div class="benefits right">

        {% for block in section.blocks %}
          {% if block.settings.position == 'right' %}
            <div class="benefit reveal-card"
              style="
                --offset-desktop: {{ block.settings.offset_desktop }}px;
                --offset-tablet: {{ block.settings.offset_tablet }}px;
                --offset-mobile: {{ block.settings.offset_mobile }}px;
                transform: translateX(calc(var(--offset-desktop) * -1));
              ">
              {% if block.settings.icon %}
                <img src="{{ block.settings.icon | image_url }}" alt="">
              {% endif %}
              <p>{{ block.settings.text }}</p>
            </div>
          {% endif %}
        {% endfor %}

        {% if section.settings.right_center_image %}
          <div class="floating-img right-center float-right">
            <img src="{{ section.settings.right_center_image | image_url }}" alt="">
          </div>
        {% endif %}

      </div>

    </div>

    <!-- CTA -->
    {% if section.settings.button_text != blank %}
      <div class="moringa-cta reveal-up">
        <a href="{{ section.settings.button_link }}" class="btn">
          {{ section.settings.button_text }}
        </a>
      </div>
    {% endif %}

  </div>
</section>

