<script>
document.addEventListener("DOMContentLoaded", function(){
  const items = document.querySelectorAll(
    "#moringa-{{ section.id }} .reveal-up, #moringa-{{ section.id }} .reveal-card"
  );

  const observer = new IntersectionObserver(entries=>{
    entries.forEach(entry=>{
      if(entry.isIntersecting){
        entry.target.classList.add("reveal-active");
        observer.unobserve(entry.target);
      }
    });
  },{threshold:0.2});

  items.forEach(i=>observer.observe(i));
});
</script>

{% schema %}
{
  "name": "Moringa Benefits Advanced",
  "settings": [
    { "type": "text", "id": "subheading", "label": "Sub Heading" },
    { "type": "text", "id": "heading", "label": "Main Heading" },
    { "type": "image_picker", "id": "center_image", "label": "Center Image" },
    { "type": "image_picker", "id": "left_top_image", "label": "Left Top Image" },
    { "type": "image_picker", "id": "left_bottom_image", "label": "Left Bottom Image" },
    { "type": "image_picker", "id": "right_center_image", "label": "Right Center Image" },
    { "type": "text", "id": "button_text", "label": "Button Text", "default": "ORDER NOW" },
    { "type": "url", "id": "button_link", "label": "Button Link" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit Item",
      "settings": [
        {
          "type": "select",
          "id": "position",
          "label": "Side",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "right", "label": "Right" }
          ]
        },
        {
          "type": "range",
          "id": "offset_desktop",
          "label": "Distance from Center (Desktop)",
          "min": 0,
          "max": 220,
          "step": 5,
          "default": 80
        },
        {
          "type": "range",
          "id": "offset_tablet",
          "label": "Distance from Center (Tablet)",
          "min": 0,
          "max": 180,
          "step": 5,
          "default": 40
        },
        {
          "type": "range",
          "id": "offset_mobile",
          "label": "Distance from Center (Mobile)",
          "min": 0,
          "max": 120,
          "step": 5,
          "default": 0
        },
        { "type": "image_picker", "id": "icon", "label": "Icon" },
        { "type": "text", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Moringa Benefits Advanced",
      "blocks": [
        { "type": "benefit" },
        { "type": "benefit" },
        { "type": "benefit" },
        { "type": "benefit" },
        { "type": "benefit" },
        { "type": "benefit" }
      ]
    }
  ]
}
{% endschema %}
