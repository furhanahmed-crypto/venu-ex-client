{{ 'NR-shop.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign source = section.settings.collection
  if source == blank
    assign source = collections.products
  endif
  if source == blank
    assign source = collections.all
  endif
-%}

<section
  class="nr-shop"
  id="nr-shop-{{ section.id }}"
  data-nr-shop
  data-section-id="{{ section.id }}"
>
  <div class="nr-shop__inner page-width">
    <header class="nr-shop__header" data-nr-reveal>
      {%- if section.settings.kicker != blank -%}
        <p class="nr-shop__kicker">{{ section.settings.kicker | escape }}</p>
      {%- endif -%}
      {%- if section.settings.title != blank -%}
        <h2 class="nr-shop__title">{{ section.settings.title | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subtitle != blank -%}
        <p class="nr-shop__subtitle">{{ section.settings.subtitle | escape }}</p>
      {%- endif -%}
    </header>

    <div class="nr-shop__groups">
      <div class="nr-shop__group" data-nr-shop-group="chips">
        <h3 class="nr-shop__group-title">{{ section.settings.chips_heading | escape }}</h3>
        <div class="nr-shop__grid" data-nr-shop-grid="chips"></div>
        <p class="nr-shop__empty hidden" data-nr-shop-empty="chips" hidden>
          {{ section.settings.empty_message | escape }}
        </p>
      </div>

      <div class="nr-shop__group" data-nr-shop-group="millet mixtures">
        <h3 class="nr-shop__group-title">{{ section.settings.millet_heading | escape }}</h3>
        <div class="nr-shop__grid" data-nr-shop-grid="millet mixtures"></div>
        <p class="nr-shop__empty hidden" data-nr-shop-empty="millet mixtures" hidden>
          {{ section.settings.empty_message | escape }}
        </p>
      </div>
    </div>
  </div>

  <template data-nr-shop-byob>
    {%- render 'nr-byob-card', variant: 'shop' -%}
  </template>

  <template data-nr-shop-spinner>
    {%- render 'loading-spinner' -%}
  </template>

  <script type="application/json" data-nr-shop-catalog>
    [
    {%- if source != blank -%}
      {%- paginate source.products by 250 -%}
        {%- assign first_entry = true -%}
        {%- for product in source.products -%}
          {%- assign type_key = product.type | strip | downcase -%}
          {%- if type_key == 'chips' or type_key == 'millet mixtures' -%}
            {%- assign variant = product.selected_or_first_available_variant -%}
            {%- assign weight_label = variant.title -%}
            {%- if product.options.size == 1 -%}
              {%- assign opt_name = product.options.first | downcase -%}
              {%- if opt_name == 'weight' and variant.option1 != blank -%}
                {%- assign weight_label = variant.option1 -%}
              {%- endif -%}
            {%- endif -%}
            {%- unless first_entry -%},{%- endunless -%}
            {
              "id": {{ product.id | json }},
              "title": {{ product.title | json }},
              "type": {{ product.type | json }},
              "url": {{ product.url | json }},
              "image": {% if product.featured_media %}{{ product.featured_media | image_url: width: 720 | json }}{% else %}""{% endif %},
              "imageAlt": {{ product.featured_media.alt | default: product.title | json }},
              "priceFormatted": {{ variant.price | money | strip_html | json }},
              "weight": {{ weight_label | json }},
              "variantId": {{ variant.id | json }},
              "available": {{ variant.available | json }}
            }
            {%- assign first_entry = false -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endpaginate -%}
    {%- endif -%}
    ]
  </script>
</section>

<script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'NR-toast.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'NR-shop.js' | asset_url }}" defer="defer"></script>

{% schema %}
{
  "name": "NR Shop",
  "tag": "section",
  "class": "section-nr-shop",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Product source collection",
      "info": "Products are filtered by Product type: chips and Millet Mixtures."
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Eyebrow",
      "default": "SHOP"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Real snacks, ready to go."
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Chips and millet mixtures — same clean ingredients, straight from our store."
    },
    {
      "type": "text",
      "id": "chips_heading",
      "label": "Chips section heading",
      "default": "Chips"
    },
    {
      "type": "text",
      "id": "millet_heading",
      "label": "Millet mixtures section heading",
      "default": "Millet Mixtures"
    },
    {
      "type": "text",
      "id": "empty_message",
      "label": "Empty category message",
      "default": "No products in this category right now."
    }
  ],
  "presets": [
    {
      "name": "NR Shop"
    }
  ]
}
{% endschema %}
