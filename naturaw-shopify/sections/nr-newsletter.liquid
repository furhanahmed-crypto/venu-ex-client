{{ 'NR-newsletter.css' | asset_url | stylesheet_tag }}

<section class="nr-newsletter" id="nr-newsletter-{{ section.id }}">
  <div class="nr-newsletter__inner page-width" data-nr-reveal>
    {%- if section.settings.title != blank -%}
      <h2 class="nr-newsletter__title">{{ section.settings.title | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.subtitle != blank -%}
      <p class="nr-newsletter__subtitle">{{ section.settings.subtitle | escape }}</p>
    {%- endif -%}

    {%- assign nr_newsletter_form_id = 'nr-newsletter-form-' | append: section.id -%}
    {%- form 'customer', id: nr_newsletter_form_id, class: 'nr-newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <div class="nr-newsletter__field">
        <label class="visually-hidden" for="nr-newsletter-email-{{ section.id }}">
          {{ 'newsletter.label' | t }}
        </label>
        <input
          id="nr-newsletter-email-{{ section.id }}"
          type="email"
          name="contact[email]"
          class="nr-newsletter__input"
          value="{{ form.email }}"
          aria-required="true"
          autocorrect="off"
          autocapitalize="off"
          autocomplete="email"
          placeholder="{{ section.settings.placeholder | escape }}"
          {% if form.errors %}
            autofocus
            aria-invalid="true"
            aria-describedby="nr-newsletter-error-{{ section.id }}"
          {% elsif form.posted_successfully? %}
            aria-describedby="nr-newsletter-success-{{ section.id }}"
          {% endif %}
          required
        >
        <button type="submit" class="nr-newsletter__submit" name="commit">
          {{ section.settings.button_label | escape }}
        </button>
      </div>

      {%- if form.errors -%}
        <p class="nr-newsletter__message nr-newsletter__message--error" id="nr-newsletter-error-{{ section.id }}">
          {{ form.errors.translated_fields.email | capitalize }}
          {{ form.errors.messages.email }}
        </p>
      {%- endif -%}

      {%- if form.posted_successfully? -%}
        <p class="nr-newsletter__message nr-newsletter__message--success" id="nr-newsletter-success-{{ section.id }}">
          {{ 'newsletter.success' | t }}
        </p>
      {%- endif -%}
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "NR Newsletter",
  "tag": "section",
  "class": "section-nr-newsletter",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Join Our Healthy Living Community"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Seasonal recipes, new drops, and nutrition tips—delivered once a week."
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Email placeholder",
      "default": "Your email address"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Subscribe"
    }
  ],
  "presets": [
    {
      "name": "NR Newsletter"
    }
  ]
}
{% endschema %}
